#!/bin/sh
# Hook pre-push: impedisce di pubblicare commit che contengono dati personali.
#
# Responsabilità: controllare i commit che stanno per essere inviati al remote
#   (email personale come autore o committer, percorsi vietati, email o segreti nel contenuto).
# Non si occupa di: controllare i file in stage (lo fa pre-commit).
# Dipendenze: common.sh, git, grep.
#
# PERCHÉ: .gitignore non toglie dalla cronologia ciò che è già stato committato;
# questo hook guarda i commit, non solo lo stato attuale dei file.

. "$(dirname "$0")/common.sh"
require_personal_email

remote_name="$1"
email=$(personal_email)
status=0

# git passa una riga per ogni riferimento: <ref locale> <sha locale> <ref remoto> <sha remoto>.
while read -r _local_ref local_sha remote_ref remote_sha; do
    # Si pubblica soltanto il ramo main: altri rami e tag restano in locale.
    # PERCHÉ: un ramo di lavoro o di archivio creato per errore non deve finire online.
    if [ "$remote_ref" != "$PUBLISHED_REF" ]; then
        echo "hook: si può pubblicare solo $PUBLISHED_REF (richiesto: $remote_ref), push bloccato." >&2
        status=1
        continue
    fi

    # Cancellazione del ramo pubblicato: si fa a mano da GitHub, mai da un push.
    if [ "$local_sha" = "$ZERO_SHA" ]; then
        echo "hook: la cancellazione di $remote_ref dal remote è bloccata." >&2
        status=1
        continue
    fi

    # Ramo nuovo: tutti i commit non ancora presenti su questo remote; altrimenti solo i nuovi.
    if [ "$remote_sha" = "$ZERO_SHA" ]; then
        range="$local_sha --not --remotes=$remote_name"
    else
        range="$remote_sha..$local_sha"
    fi

    # shellcheck disable=SC2086  # PERCHÉ: $range va diviso in più argomenti di proposito.
    commits=$(git rev-list $range)

    for commit in $commits; do
        # Email personale come autore o committer.
        identities=$(git show -s --format='%ae %ce' "$commit" | tr 'A-Z' 'a-z')
        case "$identities" in
            *"$(echo "$email" | tr 'A-Z' 'a-z')"*)
                echo "hook: $(git show -s --format='%h %s' "$commit") ha l'email personale come autore." >&2
                status=1 ;;
        esac

        # Percorsi vietati o fuori dalla lista consentita toccati dal commit.
        # PERCHÉ: --diff-filter=ACMR ignora le cancellazioni; togliere un file vietato dal repository è lecito.
        touched=$(git -c core.quotepath=off diff-tree --root --no-commit-id --name-only --diff-filter=ACMR -r "$commit")
        paths=$(echo "$touched" | grep -E "$FORBIDDEN_PATH_REGEX" || true)
        if [ -n "$paths" ]; then
            echo "hook: $(git show -s --format='%h %s' "$commit") contiene file personali o locali." >&2
            status=1
        fi
        unlisted=$(echo "$touched" | grep -v -E "$ALLOWED_PATH_REGEX" || true)
        if [ -n "$unlisted" ]; then
            echo "hook: $(git show -s --format='%h %s' "$commit") tocca percorsi non consentiti:" >&2
            echo "$unlisted" | sed 's/^/   /' >&2
            status=1
        fi
    done

    # Note private e parole vietate (solo gli hash dei commit, mai la parola).
    # shellcheck disable=SC2086
    marked=$(git log --format='%h %s' -i -G"$PRIVATE_MARKER_REGEX" $range)
    if [ -n "$marked" ]; then
        echo "hook: commit con note segnate come private:" >&2
        echo "$marked" | sed 's/^/   /' >&2
        status=1
    fi
    private_words | while IFS= read -r word; do
        [ -z "$word" ] && continue
        escaped=$(printf '%s' "$word" | sed 's/[][\.*^$/]/\\&/g')
        # shellcheck disable=SC2086
        git log --format='%h %s' -i -G"$escaped" $range
    done | sort -u > "$(git rev-parse --git-dir)/hook-word-hits"
    if [ -s "$(git rev-parse --git-dir)/hook-word-hits" ]; then
        echo "hook: una parola vietata (hook.privateWord) compare in questi commit:" >&2
        sed 's/^/   /' "$(git rev-parse --git-dir)/hook-word-hits" >&2
        status=1
    fi
    rm -f "$(git rev-parse --git-dir)/hook-word-hits"

    # Email o segreti introdotti nel contenuto da uno dei commit (si stampano solo gli hash).
    # shellcheck disable=SC2086
    leaks=$(git log --format='%h %s' -S"$email" $range)
    if [ -n "$leaks" ]; then
        echo "hook: l'email personale compare nel contenuto di questi commit:" >&2
        echo "$leaks" | sed 's/^/   /' >&2
        status=1
    fi
    # shellcheck disable=SC2086
    secrets=$(git log --format='%h %s' -G"$SECRET_REGEX" $range)
    if [ -n "$secrets" ]; then
        echo "hook: possibili segreti nel contenuto di questi commit:" >&2
        echo "$secrets" | sed 's/^/   /' >&2
        status=1
    fi
done

if [ "$status" -ne 0 ]; then
    echo "hook: push bloccato. Riscrivi la cronologia o usa un ramo pulito prima di pubblicare." >&2
fi
exit $status
